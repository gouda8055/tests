# Copy to .env.local and fill in real values. Never commit .env.local.
# Use separate Supabase projects/keys for development and production (SECURITY.md §2).

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Base domain tenants are subdomains of. Use a *.localtest.me host in dev
# (resolves to 127.0.0.1 with no /etc/hosts changes), e.g. acme.localtest.me:3000.
NEXT_PUBLIC_APP_DOMAIN=localtest.me

# --- Server-only (never prefix with NEXT_PUBLIC_, never commit real values) ---
# Bypasses RLS. Used only in server-only modules under src/lib/supabase/admin.ts
# and the /platform route handlers. See SECURITY.md §2.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
