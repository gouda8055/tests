# Copy to .env.local and fill in real values. Never commit .env.local.
# Use separate Supabase projects/keys for development and production (SECURITY.md §2).

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Base domain tenants are subdomains of. Use a *.localtest.me host in dev
# (resolves to 127.0.0.1 with no /etc/hosts changes), e.g. acme.localtest.me:3000.
NEXT_PUBLIC_APP_DOMAIN=localtest.me

# --- Server-only (never prefix with NEXT_PUBLIC_, never commit real values) ---
# Bypasses RLS. Used only in server-only modules under src/lib/supabase/admin.ts
# and the /platform route handlers. See SECURITY.md §2.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Bunny Stream (server-only, all optional) ---
# Video playback stays disabled ("not configured" message) until these are
# set. Token authentication must be enabled on the library, and domain/
# referrer locking configured in the Bunny dashboard (SECURITY.md §6).
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# --- Vercel Cron (server-only, optional) ---
# Protects /api/cron/finalize-expired-attempts, which sweeps and grades
# timed-out quiz attempts (Stage 3). Leave unset locally; the route returns
# 500 rather than running unauthenticated. Generate a random value for
# production (e.g. `openssl rand -hex 32`) and set it in Vercel's project
# env vars — Vercel then sends it back automatically as
# `Authorization: Bearer <value>` on every scheduled invocation. See
# vercel.json for the schedule.
CRON_SECRET=
